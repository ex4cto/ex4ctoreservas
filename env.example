# Plantilla de configuracion. Copiar a .env y completar.
# NINGUN valor real se hardcodea en el codigo: todo viene de aqui o del entorno.

# Entorno de ejecucion: desarrollo | produccion | pruebas
GARAY_ENTORNO=desarrollo

# Secretos (dejar vacios en el ejemplo)
GARAY_DATABASE_URL=
GARAY_TELEGRAM_BOT_TOKEN=
GARAY_GRUPO_ID=
GARAY_WEBHOOK_SECRET=

# Moneda base del sistema
GARAY_MONEDA_PREDETERMINADA=COP

# Ollama AI configuration
GARAY_OLLAMA_URL=
GARAY_OLLAMA_MODELO=
